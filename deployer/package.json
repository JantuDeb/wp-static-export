{
  "name": "static-deployer",
  "version": "0.1.0",
  "description": "Deployment providers for the static WordPress exporter (GitHub, Netlify, Cloudflare Pages, S3, BunnyCDN, SFTP).",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/cli.cjs --external:cpu-features --external:./crypto/build/Release/sshcrypto.node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ssh2-sftp-client": "^9.0.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
