{
  "name": "static-deployer",
  "version": "0.1.0",
  "description": "Browser-side and build tooling for WP Static Export: the admin screens, form and search scripts, and the Lighthouse audit tool. The deploy and optimization engine is PHP (src/engine).",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "build": "npm run build:admin && npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:admin": "esbuild src/admin/settings.ts src/admin/report.ts --bundle --minify --target=es2019 --format=iife --outdir=dist/admin",
    "build:web": "esbuild src/web/forms.ts src/web/search.ts --bundle --minify --target=es2019 --format=iife --outdir=dist/web",
    "lighthouse": "tsx tools/lighthouse/cli.ts",
    "lighthouse:demo": "tsx tools/lighthouse/cli.ts --demo --fix --optimize --meta --pages 4 --runs 3"
  },
  "dependencies": {
    "fuse.js": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
